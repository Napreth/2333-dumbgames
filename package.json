{
  "name": "2333-dumbgames",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:web && pnpm build:toy",
    "build:web": "node scripts/build-web.mjs",
    "build:toy": "vite build --mode toy",
    "deploy:web": "wrangler deploy",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "balance:number-gates": "node scripts/number-gates-balance.mjs"
  },
  "dependencies": {
    "three": "0.180.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0",
    "wrangler": "^4.158.0"
  }
}
